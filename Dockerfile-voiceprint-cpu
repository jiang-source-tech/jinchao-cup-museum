# syntax=docker/dockerfile:1

FROM python:3.10-slim AS source

ARG VOICEPRINT_COMMIT=b2020836947d82d0ab8dc1b2562e8ded1ab17916
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=

RUN sources="/etc/apt/sources.list /etc/apt/sources.list.d/debian.sources" && \
    for source_file in $sources; do \
      [ -f "$source_file" ] || continue; \
      if [ -n "$DEBIAN_SECURITY_MIRROR" ]; then \
        sed -i \
          -e "s|http://security.debian.org/debian-security|$DEBIAN_SECURITY_MIRROR|g" \
          -e "s|http://deb.debian.org/debian-security|$DEBIAN_SECURITY_MIRROR|g" \
          "$source_file"; \
      fi; \
      if [ -n "$DEBIAN_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org/debian|$DEBIAN_MIRROR|g" "$source_file"; \
      fi; \
    done && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /src && \
    curl -fsSL "https://github.com/xinnan-tech/voiceprint-api/archive/${VOICEPRINT_COMMIT}.tar.gz" \
      | tar -xz --strip-components=1 -C /src

FROM python:3.10-slim AS builder

ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=

RUN sources="/etc/apt/sources.list /etc/apt/sources.list.d/debian.sources" && \
    for source_file in $sources; do \
      [ -f "$source_file" ] || continue; \
      if [ -n "$DEBIAN_SECURITY_MIRROR" ]; then \
        sed -i \
          -e "s|http://security.debian.org/debian-security|$DEBIAN_SECURITY_MIRROR|g" \
          -e "s|http://deb.debian.org/debian-security|$DEBIAN_SECURITY_MIRROR|g" \
          "$source_file"; \
      fi; \
      if [ -n "$DEBIAN_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org/debian|$DEBIAN_MIRROR|g" "$source_file"; \
      fi; \
    done && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gcc g++ make && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=source /src/requirements.txt .

# voiceprint-api v0.0.4 pins torch 2.2.2. On amd64, install its CPU wheel first so
# the upstream requirement is satisfied without pulling CUDA 12 libraries.
ARG TARGETARCH
ARG PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG PYPI_INDEX_URL=https://pypi.org/simple
ARG PYARROW_VERSION=20.0.0
RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    if [ "$arch" = "amd64" ]; then \
      curl -fL --retry 5 --retry-all-errors --connect-timeout 15 --max-time 600 \
        "$PYTORCH_CPU_INDEX_URL/torch-2.2.2%2Bcpu-cp310-cp310-linux_x86_64.whl" \
        -o /tmp/torch-2.2.2+cpu-cp310-cp310-linux_x86_64.whl && \
      curl -fL --retry 5 --retry-all-errors --connect-timeout 15 --max-time 600 \
        "$PYTORCH_CPU_INDEX_URL/torchaudio-2.2.2%2Bcpu-cp310-cp310-linux_x86_64.whl" \
        -o /tmp/torchaudio-2.2.2+cpu-cp310-cp310-linux_x86_64.whl && \
      pip install --no-cache-dir \
        --index-url "$PYPI_INDEX_URL" \
        /tmp/torch-2.2.2+cpu-cp310-cp310-linux_x86_64.whl \
        /tmp/torchaudio-2.2.2+cpu-cp310-cp310-linux_x86_64.whl && \
      rm -f /tmp/torch-2.2.2+cpu-cp310-cp310-linux_x86_64.whl \
        /tmp/torchaudio-2.2.2+cpu-cp310-cp310-linux_x86_64.whl; \
    fi && \
    pip install --no-cache-dir --index-url "$PYPI_INDEX_URL" \
      "pyarrow==$PYARROW_VERSION" -r requirements.txt

FROM python:3.10-slim

ARG VOICEPRINT_COMMIT=b2020836947d82d0ab8dc1b2562e8ded1ab17916
LABEL org.opencontainers.image.source="https://github.com/xinnan-tech/voiceprint-api" \
      org.opencontainers.image.revision="${VOICEPRINT_COMMIT}"

WORKDIR /app
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=source /src /app

RUN mkdir -p tmp data logs

CMD ["python", "start_server.py"]
